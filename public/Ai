<!-- Universal AI Helper <div> for any normal HTML website -->
<div id="site-ai-helper-box" style="max-width:460px;margin:24px auto;border:1px solid #e2e8f0;border-radius:16px;background:#ffffff;color:#0f172a;font-family:'Poppins','Noto Sans Sinhala',system-ui,sans-serif;overflow:hidden;box-shadow:0 10px 30px rgba(15,23,42,.08)">
  <div style="background:#ffc900;color:#111;padding:13px 16px;display:flex;align-items:center;justify-content:space-between;font-weight:700;font-size:14px">
    <span>AI Helper</span>
    <button id="uAiLangBtn" type="button" style="background:rgba(17,17,17,.14);border:0;color:#111;padding:4px 10px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer">EN</button>
  </div>
  <div id="uAiMsgs" style="height:300px;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:8px;background:#f8fafc"></div>
  <form id="uAiForm" style="display:flex;gap:8px;padding:10px;border-top:1px solid #e2e8f0;background:#fff">
    <input id="uAiInp" type="text" placeholder="ප්‍රශ්නයක් අසන්න..." style="flex:1;padding:9px 12px;border:1px solid #cbd5e1;border-radius:10px;font-size:13px;outline:none">
    <button id="uAiSend" type="submit" style="background:#ffc900;color:#111;border:0;border-radius:10px;padding:9px 16px;font-weight:700;font-size:13px;cursor:pointer">Send</button>
  </form>
</div>
<script>
(function () {
  var API_URL = 'https://mcgitgrid.vercel.app/api/ai';
  var lang = 'si', hist = [];
  var msgs = document.getElementById('uAiMsgs'), inp = document.getElementById('uAiInp');
  var btn = document.getElementById('uAiSend'), langBtn = document.getElementById('uAiLangBtn');

  function renderRich(el, raw) {
    while (el.firstChild) el.removeChild(el.firstChild);
    String(raw || '').split('\n').forEach(function (line, i) {
      if (i > 0) el.appendChild(document.createElement('br'));
      line.replace(/^\s*[-*]\s+/, '• ').split(/(\*\*[^*]+\*\*|`[^`]+`)/g).forEach(function (p) {
        if (p.indexOf('**') === 0 && p.lastIndexOf('**') === p.length - 2 && p.length > 4) {
          var s = document.createElement('strong');
          s.style.cssText = 'background:rgba(255,201,0,.22);color:#92400e;font-weight:700;padding:1px 5px;border-radius:4px;';
          s.textContent = p.slice(2, -2); el.appendChild(s);
        } else if (p.indexOf('`') === 0 && p.lastIndexOf('`') === p.length - 1 && p.length > 2) {
          var c = document.createElement('code');
          c.style.cssText = 'font-family:monospace;font-size:12px;background:#e2e8f0;padding:1px 5px;border-radius:4px;';
          c.textContent = p.slice(1, -1); el.appendChild(c);
        } else if (p) el.appendChild(document.createTextNode(p));
      });
    });
  }
  function add(role, text) {
    var d = document.createElement('div');
    d.style.cssText = 'max-width:85%;padding:9px 12px;border-radius:12px;font-size:13px;line-height:1.5;' +
      (role === 'user' ? 'align-self:flex-end;background:#ffc900;color:#111;font-weight:500;' : 'align-self:flex-start;background:#fff;border:1px solid #e2e8f0;color:#0f172a;');
    if (role === 'assistant') renderRich(d, text); else d.textContent = text;
    msgs.appendChild(d); msgs.scrollTop = msgs.scrollHeight; return d;
  }
  function reset() {
    while (msgs.firstChild) msgs.removeChild(msgs.firstChild);
    var w = lang === 'si' ? 'ආයුබෝවන්! මගෙන් ඕනෑම ප්‍රශ්නයක් අසන්න.' : 'Hello! Ask me anything.';
    langBtn.textContent = lang === 'si' ? 'EN' : 'සිං';
    inp.placeholder = lang === 'si' ? 'ප්‍රශ්නයක් අසන්න...' : 'Ask a question...';
    hist = [{ role: 'assistant', text: w }]; add('assistant', w);
  }
  reset();
  langBtn.onclick = function () { lang = lang === 'si' ? 'en' : 'si'; reset(); };
  document.getElementById('uAiForm').onsubmit = async function (e) {
    e.preventDefault();
    var q = inp.value.trim(); if (!q || btn.disabled) return;
    hist.push({ role: 'user', text: q }); add('user', q); inp.value = ''; btn.disabled = true;
    var wait = add('assistant', lang === 'si' ? 'පිළිතුර සකසමින්...' : 'Thinking...');
    try {
      var r = await fetch(API_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mode: 'chat', replyLang: lang, messages: hist }) });
      var j = await r.json(); renderRich(wait, j.reply || j.error || 'Error');
      if (j.reply) hist.push({ role: 'assistant', text: j.reply });
    } catch (_) { wait.textContent = 'Connection error'; } finally { btn.disabled = false; }
  };
})();
</script>
